<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.modula</groupId>
    <artifactId>modula</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Modula</name>
    <description>A simple FM/AM broadcast radio receiver for RTL-SDR dongles</description>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>26.0.1</javafx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <atlantafx.version>2.1.0</atlantafx.version>
        <dbus.version>5.1.1</dbus.version>
        <slf4j.version>2.0.17</slf4j.version>
        <junit.version>5.11.4</junit.version>
        <spotless.version>2.44.5</spotless.version>
        <palantir.version>2.72.0</palantir.version>
        <!-- Prism pipeline order, per-OS. Overridden in the os-* profiles below. -->
        <prism.pipeline>es2,sw</prism.pipeline>

        <!-- Stamped into build-info.properties, so AppInfo has one source rather than a constant to
             forget. Blanking either makes that half inert rather than broken — an unconfigured update
             endpoint disables its own setting and says why. -->
        <modula.homepage>https://github.com/adriandeleon/Modula</modula.homepage>
        <modula.releases.api>https://api.github.com/repos/adriandeleon/Modula/releases/latest</modula.releases.api>

        <exec.plugin.version>3.5.0</exec.plugin.version>
        <dependency.plugin.version>3.11.0</dependency.plugin.version>
        <antrun.plugin.version>3.1.0</antrun.plugin.version>
        <buildhelper.plugin.version>3.6.0</buildhelper.plugin.version>

        <jpackage.vendor>Adrian De Leon</jpackage.vendor>
        <!-- Overridable: -Djpackage.type=APP_IMAGE gives an unpackaged bundle, which is much faster
             to iterate on than building a real installer. -->
        <jpackage.type>${jpackage.defaultType}</jpackage.type>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <!-- Themes the five standard controls the radio uses, so modula.css only has to describe
             the parts no toolkit has heard of: the glass, the dial, the meter, the preset chips. -->
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>

        <!-- The Linux tray. GNOME dropped the legacy AWT tray in 3.26, so a modern desktop needs
             the StatusNotifierItem D-Bus protocol; Windows and macOS still use the AWT backend. -->
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-core</artifactId>
            <version>${dbus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.hypfvieh</groupId>
            <artifactId>dbus-java-transport-native-unixsocket</artifactId>
            <version>${dbus.version}</version>
        </dependency>
        <!-- dbus-java logs through slf4j; route it into the JDK's logging rather than leaving the
             no-op binding to swallow a tray failure silently. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Only the one file is filtered. A blanket filter would rewrite anything that happens
                 to contain ${...} and corrupt any binary resource added later. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>com/modula/build-info.properties</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>com/modula/build-info.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.modula/com.modula.ModulaApp</mainClass>
                    <options>
                        <option>-Dprism.order=${prism.pipeline}</option>
                        <!-- javafx.graphics loads its own native libs; com.modula is for the Panama
                             bindings in source/RtlSdrNativeSource. Restricted methods are warned about
                             today and blocked in a future release, so declare both now. -->
                        <option>--enable-native-access=com.modula,javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Tests run on the classpath as the unnamed module, so setAccessible is
                         unrestricted and test classes need no module-info entries. That also means
                         the Panama bindings live in ALL-UNNAMED here rather than in com.modula. -->
                    <useModulePath>false</useModulePath>
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <removeUnusedImports/>
                        <palantirJavaFormat>
                            <version>${palantir.version}</version>
                        </palantirJavaFormat>
                        <importOrder>
                            <order>java|javax,javafx,,\#</order>
                        </importOrder>
                        <toggleOffOn/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <!-- Gate at verify only, so the `mvn javafx:run` / `mvn compile` dev loop
                             is never blocked by formatting. Run `mvn spotless:apply` before committing. -->
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>os-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <prism.pipeline>mtl,es2,sw</prism.pipeline>
                <!-- Bundle metadata only: jpackage refuses a version whose first number is zero on
                     macOS alone, so 0.1.0 ships as 1.1.0 in CFBundleVersion. -->
                <jpackage.zeroMajorReplacement>1.</jpackage.zeroMajorReplacement>
                <jpackage.defaultType>dmg</jpackage.defaultType>
                <jpackage.icon>${project.basedir}/branding/modula.icns</jpackage.icon>
                <jpackage.resourceDir>${project.basedir}/packaging/mac</jpackage.resourceDir>
            </properties>
        </profile>
        <profile>
            <id>os-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <prism.pipeline>d3d,es2,sw</prism.pipeline>
                <jpackage.zeroMajorReplacement>0.</jpackage.zeroMajorReplacement>
                <jpackage.defaultType>msi</jpackage.defaultType>
                <jpackage.icon>${project.basedir}/branding/modula.ico</jpackage.icon>
                <jpackage.resourceDir>${project.basedir}/packaging/windows</jpackage.resourceDir>
            </properties>
        </profile>
        <profile>
            <id>os-linux</id>
            <activation>
                <os><family>unix</family><name>Linux</name></os>
            </activation>
            <properties>
                <prism.pipeline>es2,sw</prism.pipeline>
                <jpackage.zeroMajorReplacement>0.</jpackage.zeroMajorReplacement>
                <jpackage.defaultType>deb</jpackage.defaultType>
                <jpackage.icon>${project.basedir}/branding/modula-icon-512.png</jpackage.icon>
                <jpackage.resourceDir>${project.basedir}/packaging/linux</jpackage.resourceDir>
            </properties>
        </profile>

        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>${buildhelper.plugin.version}</version>
                        <executions>
                            <!--
                                jpackage rejects a non-numeric app version, so 0.1.0-SNAPSHOT fails
                                outright, and macOS additionally rejects a leading zero. The delivered
                                metadata therefore needs two numbers: the true one, and one jpackage
                                will accept.
                            -->
                            <execution>
                                <id>public-version</id>
                                <phase>initialize</phase>
                                <goals><goal>regex-property</goal></goals>
                                <configuration>
                                    <name>jpackage.publicVersion</name>
                                    <value>${project.version}</value>
                                    <regex>-SNAPSHOT$</regex>
                                    <replacement/>
                                    <failIfNoMatch>false</failIfNoMatch>
                                </configuration>
                            </execution>
                            <execution>
                                <id>app-version</id>
                                <phase>initialize</phase>
                                <goals><goal>regex-property</goal></goals>
                                <configuration>
                                    <name>jpackage.appVersion</name>
                                    <value>${jpackage.publicVersion}</value>
                                    <regex>^0\.</regex>
                                    <replacement>${jpackage.zeroMajorReplacement}</replacement>
                                    <failIfNoMatch>false</failIfNoMatch>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>${dependency.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>collect-modules</id>
                                <phase>prepare-package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>${antrun.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>drop-empty-javafx-jars</id>
                                <phase>prepare-package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <!--
                                            openjfx publishes each module twice: a classifier-less jar
                                            that is genuinely EMPTY (measured: 2 entries, 70 bytes) and
                                            the real one carrying module-info and the natives under a
                                            platform classifier. Both are in the dependency tree, so
                                            both get copied, and two jars claiming module javafx.graphics
                                            on one module path is an error at best — at worst the empty
                                            one wins and the image is missing its graphics stack.
                                        -->
                                        <delete verbose="true">
                                            <fileset dir="${project.build.directory}/modules"
                                                     includes="javafx-*-${javafx.version}.jar"/>
                                        </delete>
                                        <!-- jpackage refuses to overwrite its destination, so a
                                             rebuild without a clean would fail on the second run. -->
                                        <delete dir="${project.build.directory}/dist" quiet="true"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>${exec.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>${jpackage.type}</argument>
                                        <argument>--name</argument>
                                        <argument>Modula</argument>
                                        <argument>--app-version</argument>
                                        <argument>${jpackage.appVersion}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${jpackage.vendor}</argument>
                                        <argument>--copyright</argument>
                                        <argument>Copyright (c) 2026 ${jpackage.vendor}</argument>
                                        <argument>--description</argument>
                                        <argument>A broadcast radio receiver for RTL-SDR dongles</argument>
                                        <argument>--icon</argument>
                                        <argument>${jpackage.icon}</argument>
                                        <argument>--module-path</argument>
                                        <argument>${project.build.directory}/modules${path.separator}${project.build.directory}/${project.build.finalName}.jar</argument>
                                        <argument>--module</argument>
                                        <argument>com.modula/com.modula.ModulaApp</argument>
                                        <argument>--resource-dir</argument>
                                        <argument>${jpackage.resourceDir}</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dprism.order=${prism.pipeline}</argument>
                                        <!--
                                            Modula reaches librtlsdr through the FFM API and JavaFX
                                            loads its own natives, both of which the JDK now warns
                                            about and intends to BLOCK by default. Declaring the two
                                            modules that legitimately do it silences the warnings and
                                            keeps the packaged app working when that day comes.
                                        -->
                                        <argument>--java-options</argument>
                                        <argument>--enable-native-access=com.modula,javafx.graphics</argument>
                                        <argument>--jlink-options</argument>
                                        <argument>--strip-debug --no-man-pages --no-header-files --compress=zip-6</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>


</project>
