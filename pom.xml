<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.modula</groupId>
    <artifactId>modula</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>Modula</name>
    <description>A simple FM/AM broadcast radio receiver for RTL-SDR dongles</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <javafx.version>26.0.1</javafx.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <junit.version>5.11.4</junit.version>
        <spotless.version>2.44.5</spotless.version>
        <palantir.version>2.72.0</palantir.version>
        <!-- Prism pipeline order, per-OS. Overridden in the os-* profiles below. -->
        <prism.pipeline>es2,sw</prism.pipeline>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.modula/com.modula.ModulaApp</mainClass>
                    <options>
                        <option>-Dprism.order=${prism.pipeline}</option>
                        <!-- javafx.graphics loads its own native libs; com.modula is for the Panama
                             bindings in source/RtlSdrNativeSource. Restricted methods are warned about
                             today and blocked in a future release, so declare both now. -->
                        <option>--enable-native-access=com.modula,javafx.graphics</option>
                    </options>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Tests run on the classpath as the unnamed module, so setAccessible is
                         unrestricted and test classes need no module-info entries. -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <removeUnusedImports/>
                        <palantirJavaFormat>
                            <version>${palantir.version}</version>
                        </palantirJavaFormat>
                        <importOrder>
                            <order>java|javax,javafx,,\#</order>
                        </importOrder>
                        <toggleOffOn/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <!-- Gate at verify only, so the `mvn javafx:run` / `mvn compile` dev loop
                             is never blocked by formatting. Run `mvn spotless:apply` before committing. -->
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>os-mac</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <prism.pipeline>mtl,es2,sw</prism.pipeline>
            </properties>
        </profile>
        <profile>
            <id>os-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <prism.pipeline>d3d,es2,sw</prism.pipeline>
            </properties>
        </profile>
        <profile>
            <id>os-linux</id>
            <activation>
                <os><family>unix</family><name>Linux</name></os>
            </activation>
            <properties>
                <prism.pipeline>es2,sw</prism.pipeline>
            </properties>
        </profile>
    </profiles>
</project>
